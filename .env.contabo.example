# Configuration VPS Contabo 24/7 — DADEREZO v4.3 (DeepSeek + Supabase + Sentinelle)
# Copiez ce fichier vers `.env` sur votre VPS Contabo (ou lancez `contabo_bootstrap.sh`)

# 1. Domaine HTTPS automatique via Caddy (ou laissez `:80` pour accès direct par l'IP Contabo)
DADEREZO_DOMAIN=:80

# 2. Base de données partagée en temps réel avec Vercel (Supabase PostgreSQL 17)
SUPABASE_URL=https://cgcygjznrvojpodzlxys.supabase.co
SUPABASE_SERVICE_ROLE_KEY=votre_cle_service_role_supabase

# 3. Sécurité API & Signature JWT Multi-Tenant
DADEREZO_API_KEY=votre_cle_maitre_secrete
DADEREZO_AUTH_SECRET=votre_secret_hmac_64_caracteres

# 4. Cerveau Agentique DeepSeek (ReAct Function-Calling natif sur les 5 agents + Diagnostic 24/7)
DEEPSEEK_API_KEY=sk-votre_cle_deepseek
DADEREZO_LLM_PROVIDER=deepseek
DADEREZO_LLM_MODEL=deepseek-chat
# (Alternative 100% locale sans frais API : commentez DEEPSEEK_API_KEY et mettez DADEREZO_LLM_PROVIDER=ollama)

# 5. Alertes proactives 24/7 (Telegram ou Webhook Slack/Discord/WhatsApp)
DADEREZO_WATCHDOG_INTERVAL=60
DADEREZO_TELEGRAM_BOT_TOKEN=
DADEREZO_TELEGRAM_CHAT_ID=
DADEREZO_ALERT_WEBHOOK_URL=
