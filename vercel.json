{
  "version": 2,
  "builds": [
    {
      "src": "api.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "storage.py",
          "net_controller.py",
          "agent_engine.py",
          "landing.html",
          "DADEREZO.html",
          "frontend.html",
          "favicon.svg",
          "favicon.ico",
          "favicon.png",
          "apple-touch-icon.png",
          "logo-icon.png",
          "logo-orbit.png",
          "og-image.png",
          "banner-network.jpg",
          "banner-partner.jpg",
          "agent_client.py",
          "collector.py",
          "make_dashboard.py",
          "devices.json"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api.py"
    }
  ]
}
