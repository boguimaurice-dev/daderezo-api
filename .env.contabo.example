# Configuration VPS Contabo 24/7 — DADEREZO v4.2
# Copiez ce fichier vers `.env` sur votre VPS Contabo

# 1. Domaine HTTPS automatique via Caddy (ou laissez `:80` pour accès direct par l'IP Contabo)
DADEREZO_DOMAIN=:80

# 2. Base de données partagée avec Vercel (Supabase PostgreSQL 17)
SUPABASE_URL=https://cgcygjznrvojpodzlxys.supabase.co
SUPABASE_SERVICE_ROLE_KEY=votre_cle_service_role_supabase

# 3. Sécurité API & Signature JWT Multi-Tenant
DADEREZO_API_KEY=votre_cle_maitre_secrete
DADEREZO_AUTH_SECRET=votre_secret_hmac_64_caracteres

# 4. Modèle IA local souverain (Ollama sur le VPS Contabo — 0 FCFA / mois de frais API)
DADEREZO_LLM_MODEL=qwen2.5:3b

# 5. Alertes proactives 24/7 (optionnel : Telegram ou Webhook Slack/Discord/WhatsApp)
DADEREZO_WATCHDOG_INTERVAL=60
DADEREZO_TELEGRAM_BOT_TOKEN=
DADEREZO_TELEGRAM_CHAT_ID=
DADEREZO_ALERT_WEBHOOK_URL=
